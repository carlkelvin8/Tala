DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
# Dedicated disposable database used by `npm test` (never point this at production).
TEST_DATABASE_URL="postgresql://user:password@host:5432/database_test?sslmode=require"
JWT_ACCESS_SECRET="your-super-secret-access-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
QR_TOKEN_SECRET="your-super-secret-qr-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
